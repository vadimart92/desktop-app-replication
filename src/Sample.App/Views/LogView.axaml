<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sample.App.ViewModels"
             x:Class="Sample.App.Views.LogView"
             x:DataType="vm:LogFeed">
  <ListBox x:Name="List" ItemsSource="{Binding Lines}" Padding="0">
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="0" />
      </Style>
    </ListBox.Styles>
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="vm:LogLine">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="mono" Text="{Binding Time}" Opacity="0.6" />
          <TextBlock Classes="mono" Text="{Binding Source}" Foreground="{Binding Brush}" MinWidth="70" FontWeight="SemiBold" />
          <SelectableTextBlock Classes="mono" Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
